{
  "name": "brianwritescode",
  "private": true,
  "description": "Brian's public scratchpad: short tagged notes, served from a Cloudflare Worker.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briward/brianwritescode.git"
  },
  "author": "Brian Ward",
  "scripts": {
    "build": "node ./bin/build.ts && vite build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:redirect": "wrangler deploy --config redirect.wrangler.jsonc",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@raptor-js/error": "^0.18.0",
    "@raptor-js/kernel": "^0.30.0",
    "@raptor-js/pages": "^0.7.0",
    "@raptor-js/router": "^0.25.0",
    "@raptor-js/types": "^0.4.0",
    "gray-matter": "^4.0.3",
    "ventojs": "^2.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "fuse.js": "^7.5.0",
    "preact": "^10.29.8",
    "prettier": "^3.10.1",
    "rehype-pretty-code": "^0.14.6",
    "shiki": "^4.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
